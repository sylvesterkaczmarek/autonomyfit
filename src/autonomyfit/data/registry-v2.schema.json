{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sylvesterkaczmarek/autonomyfit/registry-v2.schema.json",
  "title": "AutonomyFit Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "registry_version",
        "generated_at",
        "expires_at",
        "source_repository",
        "publisher"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "registry_version": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_url"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_url",
        "metric",
        "value"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "dataset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_url",
        "gb",
        "scope"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "family",
        "task",
        "modalities",
        "upstream",
        "parameters",
        "input",
        "compatibility",
        "license",
        "evidence",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "variant"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "task": {
          "enum": [
            "detection",
            "vlm"
          ]
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "output": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "source_url",
            "revision",
            "release_date",
            "last_checked"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "release_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "last_checked": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "millions",
            "flops_b"
          ],
          "properties": {
            "millions": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "flops_b": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimes",
            "precisions",
            "quantizations"
          ],
          "properties": {
            "runtimes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "precisions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "quantizations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "status",
            "source_url",
            "note"
          ],
          "properties": {
            "spdx": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "published",
                "unknown",
                "restricted"
              ]
            },
            "source_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accuracy",
            "memory",
            "compatibility",
            "benchmark_refs"
          ],
          "properties": {
            "accuracy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/accuracy"
              }
            },
            "memory": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/memory"
              }
            },
            "compatibility": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source"
              }
            },
            "benchmark_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "last_verified"
          ],
          "properties": {
            "status": {
              "enum": [
                "discovered",
                "source_verified",
                "compatibility_verified",
                "benchmarked"
              ]
            },
            "last_verified": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
